/* Os glifos do escalão de cada instância (createEchelonSymbol): glifos espaçados
   1,5 x tamanho ao longo do rumo local, o conjunto centrado em L x ratio.
   @@FORMA@@ dá a geometria do caractere @ch centrado em @ci. A instância sem nenhum traço
   (o escalão só de círculos, 'o', 'oo', 'ooo', nas linhas) dá collect_geometries de uma lista
   vazia, que é a geometria NULA e não o valor nulo: o filtro a tira, senão o collect do eixo
   com ela dá nulo e o Limite inteiro some (o desenho e o .ebgeo exportado). */
array_filter(array_foreach(generate_series(0, @ni - 1),
  @@SEJA@@
  @@INSTANCIA:I=@element@@
  ne2 ::= length(@ech)
  esp ::= @s * 1.5
  pi0 := project(@ce, -(@ne2 - 1) * @esp / 2, @az)
  @@EM@@
  CASE WHEN @ne2 > 0 THEN
    collect_geometries(array_filter(array_foreach(generate_series(0, @ne2 - 1),
      @@SEJA@@
      ci := project(@pi0, @element * @esp, @az)
      ch := substr(@ech, @element + 1, 1)
      @@EM@@
      @@FORMA@@
      @@FIM@@), @element IS NOT NULL))
  END
  @@FIM@@),
  NOT is_empty_or_null(@element))
