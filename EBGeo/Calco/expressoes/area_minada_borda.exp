/* 270800 Área minada: a borda interrompida por um vão de 1,3 s em cada "M"
   (buildAreaDecorations, border 'minada'). Trecho que passa pelo fim do anel vira duas
   partes. Sem cruzamento, ou com vãos maiores que a borda, o anel inteiro. */
@@SEJA@@
@@AREA@@
@@AREA_CENTRO@@
@@AREA_CRUZAMENTOS@@
nc ::= array_length(@ca)
gap ::= 1.3 * @s
@@EM@@
transform(CASE WHEN @nc = 0 OR @gap * @nc >= @L THEN @an ELSE
  collect_geometries(array_filter(array_foreach(generate_series(0, @nc - 1),
    @@SEJA@@
    u0 ::= @ca[@element] + @gap / 2
    u1 ::= CASE WHEN @element + 1 < @nc THEN @ca[@element + 1] ELSE @ca[0] + @L END - @gap / 2
    d0 ::= @@POS:A=@u0@@
    d1 ::= @@POS:A=@u1@@
    @@EM@@
    CASE WHEN @u1 > @u0 THEN
      CASE WHEN @d1 > @d0 THEN line_substring(@an, @d0, @d1)
        ELSE collect_geometries(line_substring(@an, @d0, @L), line_substring(@an, 0, @d1)) END
    END
    @@FIM@@), @element IS NOT NULL))
END, @crs_loc, @layer_crs)
@@FIM@@
