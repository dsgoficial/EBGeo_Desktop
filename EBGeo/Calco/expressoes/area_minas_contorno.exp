/* 270800: a mina de qualquer tipo (só o contorno) e as duas antenas da antipessoal, de
   0,69 a 1,38 do semieixo, a 45 graus para cima. */
@@SEJA@@
@@AREA@@
@@AREA_CENTRO@@
@@AREA_MINAS@@
@@EM@@
with_variable('mm', array_filter(array_foreach(generate_series(0, 2),
    CASE WHEN @mk[@element] IN ('ap', 'qualquer') THEN
      @@SEJA@@
      ce := make_point(x(@ct) + (@element - 1) * 2.6 * @s, y(@ct))
      az := pi() / 2
      a0 ::= 0.69 * @s
      a1 ::= 1.38 * @s
      @@EM@@
      CASE WHEN @mk[@element] = 'qualquer' THEN @@MINA_ELIPSE@@
      ELSE collect_geometries(
        make_line(make_point(x(@ce) - @a0, y(@ce) + @a0), make_point(x(@ce) - @a1, y(@ce) + @a1)),
        make_line(make_point(x(@ce) + @a0, y(@ce) + @a0), make_point(x(@ce) + @a1, y(@ce) + @a1)))
      END
      @@FIM@@
    END), @element IS NOT NULL),
  CASE WHEN array_length(@mm) > 0 THEN transform(collect_geometries(@mm), @crs_loc, @layer_crs) END)
@@FIM@@
