/* 290303 Cerca de arame dupla: dois asteriscos a 27 % e 73 % do vão, raio 0,45 x @h. */
@@SEJA@@
q1 := line_interpolate_point(@g, @f0 + (@f1 - @f0) * 0.27)
q2 := line_interpolate_point(@g, @f0 + (@f1 - @f0) * 0.73)
@@EM@@
collect_geometries(array_foreach(array(0, 60, 120, 1000, 1060, 1120),
  make_line(project(CASE WHEN @element < 1000 THEN @q1 ELSE @q2 END, @h * 0.45, @az + radians(@element % 1000)),
            project(CASE WHEN @element < 1000 THEN @q1 ELSE @q2 END, @h * 0.45, @az + radians(@element % 1000) + pi()))))
@@FIM@@
